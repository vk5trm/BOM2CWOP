@app.route('/weather')
def weather():
    """Returns Standard METAR text metadata with a Date/Time header line"""
    output_lines = []
    
    station_filter = request.args.get('station', '').strip().lower()

    # --- 1. Generate Date/Time Line (YYYY/MM/DD HH:MM) ---
    # Using local time or UTC depending on preference. 
    # The code below uses UTC to match standard METAR practices.
    now = time.gmtime()
    date_time_str = time.strftime("%Y/%m/%d %H:%M", now)
    
    # Add this as the very first line of output
    output_lines.append(date_time_str)

    # Get current UTC time for the METAR timestamp (internal format)
    metar_time = time.strftime("%d%H%MZ", now)

    for full_id, config in STATION_CONFIG.items():
        parts = full_id.split('.')
        station_product_code = parts[0]
        station_id = parts[-1]
        
        station_name = config.get('name', f"Station {station_id}")
        
        # Filter Logic
        if station_filter:
            if station_filter not in station_name.lower() and station_filter not in station_id.lower():
                continue

        obs, _ = fetch_bom_data(station_id, station_product_code)
        
        if not obs:
            if not station_filter or station_name.lower().startswith(station_filter):
                # Optional: You might want to skip adding "NO DATA" lines to keep it clean,
                # or keep them for debugging.
                pass 
            continue

        # --- Extract Data (Robust Version) ---
        temp_c = obs.get('air_temp')
        humidity = obs.get('rel_hum')
        press_hpa = obs.get('press')
        vis_km = obs.get('vis_km') or obs.get('vis') or obs.get('visibility')

        # --- Rain Extraction (Safe) ---
        rain_mm_val = None
        rain_mm_raw = obs.get('rain_ten')
        if rain_mm_raw is not None:
            try:
                rain_mm_val = float(rain_mm_raw)
            except:
                rain_mm_val = None
        weather_desc = obs.get('weather') or ""
        weather_lower = weather_desc.lower()

        # Separate checks for Rain vs Showers
        is_rain = any(word in weather_lower for word in ("rain",))
        is_shower = any(word in weather_lower for word in ("shower", "showers"))
        is_thunderstorm = any(word in weather_lower for word in ("thunder",))

        # has_rain remains true if EITHER is present (or if numeric rain exists)
        has_rain = is_rain or is_shower or is_thunderstorm or (rain_mm_val is not None and rain_mm_val > 0)

        # --- Wind Extraction ---
        wind_dir_val = obs.get('wind_dir')
        wind_spd_kmh = obs.get('wind_spd_kmh')
        wind_spd_kt = obs.get('wind_spd_kt')
        gust_kmh = obs.get('gust_kmh')
        gust_kt = obs.get('gust_kt')

        # --- Cloud Extraction (Strict Data Check) ---
        cloud_str = "///"
        cloud_oktas = obs.get('cloud_oktas')
        cloud_base_m_flat = obs.get('cloud_base_m')
        cloud_desc = obs.get('cloud', '')

        metar_amount = None
        base_ft_final = 0
        data_found = False
        vis_str = "9999" 
        weather_str = ""

        if cloud_desc and cloud_desc != "-":
            try:
                # Determine Amount from Oktas
                oktas = int(cloud_oktas) if cloud_oktas is not None else 0
                
                if oktas == 0:
                    metar_amount = "SKC"
                elif oktas <= 1:
                    metar_amount = "FEW"
                elif oktas <= 3:
                    metar_amount = "SCT"
                elif oktas <= 5:
                    metar_amount = "BKN"
                else: # 6, 7, 8
                    metar_amount = "OVC"

                # Determine Height from Base Meters
                if cloud_base_m_flat is not None:
                    base_m_val = float(cloud_base_m_flat)
                    base_ft = base_m_val * 3.28084
                    base_ft_rounded = round(base_ft / 100) * 100
                    if base_ft_rounded < 50:
                        base_ft_final = 0
                    else:
                        base_ft_final = int(base_ft_rounded)

                data_found = True
            except Exception:
                pass
        # 2. FALLBACK: Check Cloud Height only -> Set to OVC
        if not data_found and cloud_base_m_flat is not None:
            try:
               base_m_val = float(cloud_base_m_flat)
               base_ft = base_m_val * 3.28084
               base_ft_rounded = round(base_ft / 100) * 100
               if base_ft_rounded < 50:
                  base_ft_final = 0
               else:
                    base_ft_final = int(base_ft_rounded)

               metar_amount = "OVC"
               data_found = True
            except Exception:
                pass

        # --- Temperature & Dew Point (Direct BOM Data) ---
        temp_str = "///"
        dew_str = "///"

        # --- Temperature Formatting ---
        if temp_c is not None:
            try:
               t = float(temp_c)
               if t < 0:
                  temp_str = f"M{abs(t):02.0f}"
               else:
                   temp_str = f"{t:02.0f}"
            except:
                   pass

        # --- Dew Point Formatting (Direct from BOM JSON "dewpt") ---
        # BOM provides dew point directly in Celsius
        raw_dewpt = obs.get('dewpt')
        if raw_dewpt is not None:
            try:
               dp = float(raw_dewpt)
               if dp < 0:
                  dew_str = f"M{abs(dp):02.0f}"
               else:
                   dew_str = f"{dp:02.0f}"
            except:
                   pass


        # --- Pressure ---
        qnh_str = f"Q{int(float(press_hpa)):04}" if press_hpa else "Q////"

        # --- Wind & Gusts (Using existing variables) ---
        wind_deg = "///"
        wind_kt_int = None
        gust_kt_val = None

        # 2. Determine Wind Direction
        wind_deg_val = None
        if wind_dir_val:
            if wind_dir_val in cardinal_lookup:
                wind_deg_val = cardinal_lookup[wind_dir_val]
            else:
                try:
                    wind_deg_val = int(float(wind_dir_val))
                except:
                    pass

        # 3. Determine Wind Speed (KT First)
        wind_kt_int = None
        
        # Try KT first
        if wind_spd_kt is not None:
            try:
                wind_kt_int = int(round(float(wind_spd_kt)))
            except:
                pass
        
        # Fallback to KM/H if KT is missing
        if wind_kt_int is None and wind_spd_kmh:
            try:
                wind_kt_int = int(round(float(wind_spd_kmh) / 1.852))
            except:
                pass

        # 4. Determine Gusts (KT First)
        gust_kt_val = None
        
        # Try KT first
        if gust_kt is not None:
            try:
                gust_kt_val = int(round(float(gust_kt)))
            except:
                pass
        
        # Fallback to KM/H
        if gust_kt_val is None and gust_kmh:
            try:
                gust_kt_val = int(round(float(gust_kmh) / 1.852))
            except:
                pass
        
        # 5. Construct Wind String
        # METAR Rules:
        # - Missing data: "///////"
        # - Calm (0 kt): "00000KT"
        # - Valid wind: "DDDSSKT" or "DDDSSGSSKT"
        
        if wind_kt_int is not None:
            if wind_kt_int == 0:
                # Calm
                wind_str = "00000KT"
            else:
                if wind_deg_val is not None:
                    # Valid direction and speed
                    wind_deg = f"{wind_deg_val:03d}"
                    wind_kt = f"{wind_kt_int:02d}"
                    
                    if gust_kt_val is not None:
                        gust_kt = f"{gust_kt_val:02d}"
                        wind_str = f"{wind_deg}{wind_kt}G{gust_kt}KT"
                    else:
                        wind_str = f"{wind_deg}{wind_kt}KT"
                else:
                    # Speed exists but direction is missing -> Invalid/Missing
                    wind_str = "///////"
        else:
            # No speed data found -> Missing
            wind_str = "///////"

            # Weather strings
            if has_rain and weather_str == "":
              if rain_mm_val is not None:
                 # Determine intensity first
                 if rain_mm_val >= 5.0:
                     intensity = "+"
                 elif rain_mm_val >= 1.0:
                     intensity = ""
                 elif rain_mm_val >= 0.1:
                     intensity = "-"
                 else:
                     intensity = "" # Default for very light
                
                # Determine type: Showers take precedence if detected
                 if is_shower:
                     weather_str = f"{intensity}SHRA"
                 elif is_rain:
                     weather_str = f"{intensity}RA"
                 elif is_thunderstorm:
                  weather_str = f"{intensity}TSRA"
                 else:
                     weather_str = "DZ" # Fallback if numeric rain exists but text says otherwise
            else:
                # If no numeric rain, rely on text description
                if is_shower:
                    weather_str = "SHRA" # Default light shower
                elif is_rain:
                    weather_str = "RA"   # Default light rain
                elif is_thunderstorm:
                    weather_str = "TSRA" # Default Thunderstorm 
                else:
                    weather_str = "DZ"    # Drizzle for very tiny amounts

        # Infer weather if data is missing 
        # Check if explicit cloud data was found in the previous section
        if not data_found:
            # Call the helper function to infer Fog/Rain
            metar_amount, base_ft_final, weather_str, vis_str, data_found = _infer_missing_weather(
                obs, humidity, temp_c, wind_kt_int, wind_spd_kt,
                has_rain, rain_mm_val, vis_km, weather_str
            )

            # Construct Cloud String based on inference result
            if data_found:
                if base_ft_final == 0:
                    cloud_str = f"{metar_amount}000"
                else:
                    cloud_str = f"{metar_amount}{int(base_ft_final/100):03d}"
            else:
                # Still no data found
                cloud_str = "///"
        else:
            # Explicit data was found, construct cloud string normally
            if metar_amount == "SKC":
                cloud_str = "SKC"
            else:
                if base_ft_final == 0:
                    cloud_str = f"{metar_amount}000"
                else:
                    cloud_str = f"{metar_amount}{int(base_ft_final/100):03d}"

        # --- 5. Visibility Logic (UPDATED) ---
        # If we didn't infer weather (no Fog/Rain), check BOM visibility data
        if not data_found:
            if vis_km:
                try:
                    vis_val = float(vis_km)
                    if vis_val >= 10:
                        vis_str = "9999"
                    elif vis_val < 0.1:
                        vis_str = "0000"
                    else:
                        vis_str = f"{int(vis_val * 1000):04d}"
                except:
                    pass
    # If vis_km is missing and no weather forced, keep default "9999"

                # --- Station ID ---
        station_code = station_name.replace(" ", "")[:4].upper() if station_name else f"STN{station_id[-3:]}"

        # --- Visibility & Cloud Logic for CAVOK ---
        # CAVOK conditions:
        # 1. Visibility >= 10km (9999)
        # 2. No cloud below 5000ft (SKC)
        # 3. No significant weather (weather_str is empty)
        
        is_cavok = False
        if vis_str == "9999" and cloud_str == "SKC" and not weather_str:
            is_cavok = True

        # --- Construct METAR Line ---
        metar_time = time.strftime("%d%H%MZ", time.gmtime())
        
        # Start with base components
        metar_parts = [
            station_code,
            metar_time,
            wind_str
        ]

        if is_cavok:
            # If CAVOK: Add CAVOK token
            # Skip explicit Vis, Cloud, and Weather codes
            metar_parts.append("CAVOK")
        else:
            # Standard Report: Vis -> Cloud -> Weather
            metar_parts.append(vis_str)
            metar_parts.append(cloud_str)
            
            if weather_str:
                metar_parts.append(weather_str)

        # --- Always Append Temperature/Dewpoint and QNH ---
        # These come after Vis/Cloud/Weather (or CAVOK)
        metar_parts.append(f"{temp_str}/{dew_str}")
        metar_parts.append(qnh_str)

        metar_line = " ".join(metar_parts)

        # --- Add RMK Section with Rainfall ---
        # Extract 9 AM / daily rain from 'rain_trace'
        rain_9am_val = obs.get('rain_trace')

        # Calculate numeric values first to check if they are > 0
        r10_num = float(rain_mm_val) if rain_mm_val is not None else 0.0
        r9_num = float(rain_9am_val) if rain_9am_val is not None else 0.0

        # Only add RMK if EITHER value is strictly greater than 0
        if r10_num > 0 or r9_num > 0:
            # Format 10-min rainfall (e.g., 00.1)
            r10_str = f"{r10_num:04.1f}"
            
            # Format 9 AM / daily rainfall (e.g., 001.8)
            r9_str = f"{r9_num:05.1f}"
            
            # Append RMK line: RMK RFrr.r/rrr.r
            metar_line += f" RMK RF{r10_str}/{r9_str}"

        # Append the final line to output
        output_lines.append(metar_line)

    if not output_lines:
        if len(output_lines) == 1:
            output_lines.append("No data found for the specified station.")
        else:
            output_lines.append("No data found for the specified station.")

    return Response("\n".join(output_lines), mimetype='text/plain; charset=utf-8')

@app.route('/aprs')
def trigger_aprs():
    """Manual trigger for testing"""
    try:
        aprs_client = APRSClient(APRS_CALL, APRS_PASSCODE, host=APRS_SERVER, port=APRS_PORT)
        aprs_client.connect()
        sent_count = 0
        
        for full_id, config in STATION_CONFIG.items():
            parts = full_id.split('.')
            station_product_code = parts[0]
            station_id = parts[-1]
            
            wx_call = config.get('aprs_call', APRS_CALL)
            station_name = config.get('name', f"Station {station_id}")
            
            obs, _ = fetch_bom_data(station_id, station_product_code)
            if obs is None:
                continue
            
            comment = ("%s WX" % station_name) or ("BOMWX %s" % station_id)
            aprs_str = bom_json_to_aprs(obs, comment=comment)
            if not aprs_str:
                continue
            
            aprs_client.send_packet(wx_call, aprs_str)
            sent_count += 1
            time.sleep(0.5)
            
        aprs_client.close()
        return jsonify({"status": "success", "packets_sent": sent_count})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)}), 500

